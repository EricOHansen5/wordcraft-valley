# Cache rules for the Cloudflare copy (Workers static assets). Mirrors what server/server.js
# sends at home, so the iPad behaves the same either way.
# Cloudflare applies every matching rule and ADDS same-named headers together, so each
# specific rule first drops the default with `! Cache-Control`, then sets its own.
# (The home server never serves this file — nothing asks for it.)

/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# ~1800 clips, and a clip never changes once it is generated.
/voice/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The clip list and the app shell must be revalidated, or a new release
# never reaches a home-screen app that already has the old one cached.
/voice/index.json
  ! Cache-Control
  Cache-Control: no-cache
/
  ! Cache-Control
  Cache-Control: no-cache
/index.html
  ! Cache-Control
  Cache-Control: no-cache
# The game's data (art/, content/) changes with each release, just like index.html.
/art/*
  ! Cache-Control
  Cache-Control: no-cache
/content/*
  ! Cache-Control
  Cache-Control: no-cache
/sw.js
  ! Cache-Control
  Cache-Control: no-cache
